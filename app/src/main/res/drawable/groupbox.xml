<?xml version="1.0" encoding="utf-8"?>
<!-- Windows 7 group box: rounded translucent panel -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#B6CFE2" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="7dp" />
            <gradient
                android:angle="270"
                android:startColor="#F7FCFF"
                android:endColor="#E6F1FA" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <stroke
                android:width="1dp"
                android:color="#A6FFFFFF" />
        </shape>
    </item>
</layer-list>
