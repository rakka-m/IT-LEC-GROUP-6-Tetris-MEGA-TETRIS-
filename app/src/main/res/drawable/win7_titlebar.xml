<?xml version="1.0" encoding="utf-8"?>
<!-- Glossy Aero title bar (38dp tall): glass gradient, specular top half, inner light edge -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="9dp"
                android:topRightRadius="9dp" />
            <gradient
                android:angle="270"
                android:startColor="#EAF5FF"
                android:centerColor="#C9E2F7"
                android:endColor="#9CC4E4" />
            <stroke
                android:width="1dp"
                android:color="#9CBED8" />
        </shape>
    </item>

    <!-- specular highlight: fills from top down to 20dp above the bottom edge -->
    <item
        android:bottom="20dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="7dp"
                android:topRightRadius="7dp" />
            <gradient
                android:angle="270"
                android:startColor="#E6FFFFFF"
                android:centerColor="#66FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

    <!-- hairline separating the title bar from the client area -->
    <item
        android:gravity="bottom"
        android:left="1dp"
        android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#8FB4D2" />
            <size android:height="1dp" />
        </shape>
    </item>
</layer-list>
