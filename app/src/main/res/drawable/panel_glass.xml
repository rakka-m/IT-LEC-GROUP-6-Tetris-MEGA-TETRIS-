<?xml version="1.0" encoding="utf-8"?>
<!-- Content card: translucent white glass with a light bevel -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/aero_border_soft" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="7dp" />
            <gradient
                android:angle="270"
                android:startColor="#FFFFFFFF"
                android:centerColor="#F7FBFF"
                android:endColor="#E9F3FC" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <stroke
                android:width="1dp"
                android:color="#99FFFFFF" />
        </shape>
    </item>
</layer-list>
