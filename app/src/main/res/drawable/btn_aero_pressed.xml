<?xml version="1.0" encoding="utf-8"?>
<!-- White glass Aero button, pressed: inverted (sunken) fill -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <solid android:color="#6E8CA6" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <gradient
                android:angle="270"
                android:startColor="#FFFFFF"
                android:centerColor="#E2EFFA"
                android:endColor="#F5FAFE" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <gradient
                android:angle="270"
                android:startColor="#38000000"
                android:centerColor="#00000000"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
