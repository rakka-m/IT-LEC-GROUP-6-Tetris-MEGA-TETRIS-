<?xml version="1.0" encoding="utf-8"?>
<!-- Checked Aero radio button: glossy blue bead -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <size
                android:width="22dp"
                android:height="22dp" />
            <solid android:color="#FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#2A7CB8" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#9AD5F7"
                android:centerColor="#3D9BE9"
                android:endColor="#12609E" />
            <stroke
                android:width="1dp"
                android:color="#0B4472" />
        </shape>
    </item>
    <item
        android:bottom="11dp"
        android:left="7dp"
        android:right="11dp"
        android:top="6dp">
        <shape android:shape="oval">
            <solid android:color="#B3FFFFFF" />
        </shape>
    </item>
</layer-list>
