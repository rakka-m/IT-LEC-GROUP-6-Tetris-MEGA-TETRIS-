<?xml version="1.0" encoding="utf-8"?>
<!-- Selawik: Microsoft's Segoe UI metric-compatible face (SIL OFL) -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <font
        android:font="@font/selawik_light"
        android:fontStyle="normal"
        android:fontWeight="300"
        app:font="@font/selawik_light"
        app:fontStyle="normal"
        app:fontWeight="300" />

    <font
        android:font="@font/selawik_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/selawik_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />

    <font
        android:font="@font/selawik_semibold"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:font="@font/selawik_semibold"
        app:fontStyle="normal"
        app:fontWeight="600" />

    <font
        android:font="@font/selawik_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/selawik_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
</font-family>
